{
  "name": "rphelper",
  "version": "0.1.0",
  "description": "WoW roleplay response co-pilot: background AI watcher + fully in-game addon GUI",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "install:addon": "powershell -ExecutionPolicy Bypass -File scripts/install-addon.ps1",
    "build:exe": "node scripts/build-exe.mjs",
    "install:autostart": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}